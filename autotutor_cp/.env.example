# Chave somente no .env local (permissão 600), nunca em relatórios.
LLM_PROVIDER=Gemini
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=4096
EXPERIMENT_MODE=research
ENABLE_LOCAL_BASELINE=true
ENABLE_EXTERNAL_API=true
# 0: sem teto diário local; interrompe ao esgotar a cota gratuita do provedor.
RESEARCH_MAX_CALLS=0
RESEARCH_MAX_RESERVED_TOKENS=0
# Uso exclusivamente na cota gratuita confirmada pelo dono da chave.
RESEARCH_FREE_TIER_ONLY=true
RESEARCH_ALLOW_PAID=false
RESEARCH_MAX_COST_USD=0
RESEARCH_MIN_INTERVAL_SECONDS=15
RESEARCH_MAX_INPUT_BYTES=18000
RESEARCH_MAX_ATTEMPTS=1
